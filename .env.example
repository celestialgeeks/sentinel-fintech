# ─── Application ───────────────────────────────────────────
APP_NAME=Sentinel
APP_ENV=development
DEBUG=true

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://sentinel:sentinel_pass@postgres:5432/sentinel
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://:sentinel_redis_pass@redis:6379/0

# ─── Milvus ────────────────────────────────────────────────
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=entities

# ─── Kafka ─────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9093
KAFKA_SCHEMA_REGISTRY=http://schema-registry:8081

# ─── JWT / Auth ────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── LLM / Embeddings ──────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_PROVIDER=openai                # or huggingface
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# ─── Monitoring ────────────────────────────────────────────
PROMETHEUS_METRICS_PORT=9090
LOG_LEVEL=INFO

# ─── Grafana (for docker-compose) ─────────────────────────
GRAFANA_PASSWORD=admin
