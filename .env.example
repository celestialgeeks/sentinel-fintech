# ─── Application ───────────────────────────────────────────
APP_NAME=Sentinel
APP_ENV=development
DEBUG=true

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sentinel:${POSTGRES_PASSWORD:-sentinel_pass}@postgres:5432/sentinel
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://:${REDIS_PASSWORD:-sentinel_redis_pass}@redis:6379/0

# ─── Milvus ────────────────────────────────────────────────
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=entities

# ─── Neo4j ─────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=${NEO4J_PASSWORD:-sentinel_neo4j_pass}

# ─── Kafka ─────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9093
KAFKA_SCHEMA_REGISTRY=http://schema-registry:8081

# ─── JWT / Auth ────────────────────────────────────────────
# Generate a real secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=${JWT_SECRET:-change-this-to-a-secure-random-string}
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── LLM / Embeddings ──────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_PROVIDER=openai                # or huggingface
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# ─── P2P Guard — vendor data sources ───────────────────────
# All optional: a provider with no key falls back to a deterministic mock so the
# guard runs before contracts are signed. Set USE_MOCKS_WHEN_UNCONFIGURED=false in
# production so an unconfigured required provider degrades to HOLD instead of mock.
USE_MOCKS_WHEN_UNCONFIGURED=true
MAX_VENDOR_LATENCY_MS=6000
CACHE_DEFAULT_TTL=300

# On-chain wallet screening
CHAINALYSIS_API_KEY=
CRYPTOAUTHET_API_KEY=
CRYPTOAUTHET_BASE_URL=https://api.cryptoauthet.com/v1
ELLIPTIC_API_KEY=

# India mule / bank-account / name intelligence
IDFY_CLIENT_ID=
IDFY_CLIENT_SECRET=
SIGNZY_PRIVATE_KEY=
SIGNZY_PUBLIC_KEY=
HYPERVERGE_API_KEY=

# Sanctions / PEP live feed (World-Check / LSEG / Dow Jones); local list is always on
SANCTIONS_FEED_URL=
SANCTIONS_API_KEY=

# Account Aggregator (consented bank-credit verification)
AA_CLIENT_ID=
AA_CLIENT_SECRET=

# ─── P2P Guard — bot authentication ────────────────────────
# When set, POST /api/v1/p2p/* requires an HMAC-signed body:
#   X-Sentinel-Signature = hex(hmac_sha256(secret, f"{timestamp}." + body))
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GUARD_HMAC_SECRET=

# ─── Monitoring ────────────────────────────────────────────
PROMETHEUS_METRICS_PORT=9090
LOG_LEVEL=INFO

# ─── Infra passwords (development only) ────────────────────
POSTGRES_PASSWORD=sentinel_pass
REDIS_PASSWORD=sentinel_redis_pass
NEO4J_PASSWORD=sentinel_neo4j_pass
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
GRAFANA_PASSWORD=admin

# ⚠️  NEVER commit a .env file with real secrets.
#    Generate strong passwords for production:
#    python -c "import secrets; print(secrets.token_hex(32))"
